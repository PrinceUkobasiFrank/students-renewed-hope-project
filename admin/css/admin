/* Admin panel — reuses tokens from ../css/style.css, adds CRM layout */

body.admin-body{background:var(--paper);}

.admin-shell{display:grid;grid-template-columns:230px 1fr;min-height:100vh;}

.admin-sidebar{
  background:var(--green-900);color:var(--white);
  padding:24px 0;position:sticky;top:0;height:100vh;overflow-y:auto;
}
.admin-brand{display:flex;align-items:center;gap:10px;padding:0 20px 24px;}
.admin-brand .brand-logo{height:32px;}
.admin-brand-label{font-size:.78rem;font-weight:700;color:#B9CBBD;text-transform:uppercase;letter-spacing:.03em;}
.admin-nav{display:flex;flex-direction:column;}
.admin-nav a{
  padding:12px 20px;color:#CFE0D3;font-weight:600;font-size:.92rem;
  border-left:3px solid transparent;
}
.admin-nav a:hover{background:rgba(255,255,255,.05);color:var(--white);}
.admin-nav a.active{color:var(--white);border-left-color:var(--gold);background:rgba(255,255,255,.06);}

.admin-main{min-width:0;}
.admin-topbar{border-bottom:1.5px solid var(--line);background:var(--white);position:sticky;top:0;z-index:20;}
.admin-topbar-inner{display:flex;justify-content:flex-end;align-items:center;gap:16px;padding:14px 32px;}
.admin-role-badge{
  font-size:.82rem;font-weight:700;color:var(--green-700);
  background:var(--paper-2);padding:6px 12px;border:1.5px solid var(--line);
}

.admin-content{padding:32px;}
.admin-page-head{margin-bottom:28px;display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:16px;}
.admin-page-head h1{font-size:2rem;margin:0;}
.admin-page-sub{color:#5B6459;margin:6px 0 0;font-size:.92rem;}

/* stat cards */
.admin-stat-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:var(--line);border:1px solid var(--line);margin-bottom:32px;}
.admin-stat-card{background:var(--white);padding:20px;}
.admin-stat-card .num{font-family:var(--font-display);font-weight:800;font-size:2.1rem;color:var(--green-900);line-height:1;}
.admin-stat-card .label{font-size:.82rem;color:#5B6459;margin-top:6px;}

/* tables */
.admin-table-wrap{background:var(--white);border:1.5px solid var(--line);overflow-x:auto;}
table.admin-table{width:100%;border-collapse:collapse;font-size:.9rem;min-width:640px;}
.admin-table th{
  text-align:left;padding:12px 16px;background:var(--paper-2);
  font-size:.78rem;font-weight:700;color:#3E463A;border-bottom:1.5px solid var(--line);
  white-space:nowrap;
}
.admin-table td{padding:12px 16px;border-bottom:1px solid var(--line);vertical-align:middle;}
.admin-table tbody tr:hover{background:var(--paper);cursor:pointer;}
.admin-table tbody tr:last-child td{border-bottom:none;}

.admin-badge{display:inline-block;padding:3px 10px;font-size:.76rem;font-weight:700;}
.admin-badge-active{background:#E4EFE7;color:var(--green-700);}
.admin-badge-pending{background:#FBEFDA;color:var(--gold-dark);}
.admin-badge-draft{background:#EEE;color:#666;}

/* filters/toolbar */
.admin-toolbar{display:flex;gap:12px;margin-bottom:18px;flex-wrap:wrap;align-items:center;}
.admin-toolbar input[type="search"],
.admin-toolbar select{
  border:1.5px solid var(--line);padding:9px 12px;font-family:var(--font-body);font-size:.88rem;background:var(--white);
}
.admin-toolbar input[type="search"]{min-width:220px;}

.admin-pagination{display:flex;justify-content:space-between;align-items:center;margin-top:16px;font-size:.85rem;color:#5B6459;}
.admin-pagination-btns{display:flex;gap:8px;}
.admin-pagination-btns button{
  border:1.5px solid var(--line);background:var(--white);padding:6px 14px;cursor:pointer;font-family:var(--font-body);
}
.admin-pagination-btns button:disabled{opacity:.4;cursor:default;}

/* two-col layout for dashboard/detail */
.admin-two-col{display:grid;grid-template-columns:1.6fr 1fr;gap:24px;align-items:start;}

/* bar chart (css-only, no dependency) */
.admin-bar-chart{display:flex;align-items:flex-end;gap:6px;height:180px;padding-top:10px;}
.admin-bar{
  flex:1;background:linear-gradient(180deg,var(--green-500),var(--green-700));
  position:relative;min-width:6px;
}
.admin-bar[data-highlight="true"]{background:linear-gradient(180deg,var(--gold),var(--gold-dark));}
.admin-bar-chart-wrap{background:var(--white);border:1.5px solid var(--line);padding:24px;}
.admin-bar-labels{display:flex;gap:6px;margin-top:8px;}
.admin-bar-labels span{flex:1;font-size:.68rem;color:#8A9080;text-align:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}

/* detail drawer */
.admin-drawer-overlay{
  position:fixed;inset:0;background:rgba(18,53,36,.4);z-index:50;
  display:flex;justify-content:flex-end;
}
.admin-drawer-overlay[hidden]{display:none;}
.admin-drawer{
  background:var(--white);width:420px;max-width:100%;height:100%;
  padding:32px;overflow-y:auto;
}
.admin-drawer-close{background:none;border:none;font-size:1.4rem;cursor:pointer;float:right;color:#5B6459;}
.admin-drawer dl{margin:20px 0;}
.admin-drawer dt{font-size:.78rem;font-weight:700;color:#8A9080;margin-top:14px;}
.admin-drawer dd{margin:2px 0 0;font-size:.95rem;}

/* news manage */
.admin-news-form{background:var(--white);border:1.5px solid var(--line);padding:24px;margin-bottom:24px;}

@media (max-width:900px){
  .admin-shell{grid-template-columns:1fr;}
  .admin-sidebar{position:static;height:auto;}
  .admin-stat-grid{grid-template-columns:repeat(2,1fr);}
  .admin-two-col{grid-template-columns:1fr;}
  .admin-content{padding:20px;}
  .admin-drawer{width:100%;}
}
