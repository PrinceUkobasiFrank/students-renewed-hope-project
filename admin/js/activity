requireAdminAuth(['super_admin', 'national_admin']);
renderAdminChrome('activity');

function getAdminToken() { return getCookie('srhp_admin_session'); }
function dateTimeFmt(iso) { return new Date(iso).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }); }

const activitySearch = document.getElementById('activitySearch');
const typeFilter = document.getElementById('typeFilter');
const activityBody = document.getElementById('activityBody');
const paginationInfo = document.getElementById('paginationInfo');
const prevPageBtn = document.getElementById('prevPage');
const nextPageBtn = document.getElementById('nextPage');

const PAGE_SIZE = 25;
let currentPage = 1;

async function renderTable() {
  const params = new URLSearchParams({ page: currentPage, pageSize: PAGE_SIZE });
  if (activitySearch.value.trim()) params.set('search', activitySearch.value.trim());
  if (typeFilter.value) params.set('type', typeFilter.value);

  try {
    const result = await apiFetch(`/api/admin/activity?${params}`, { authToken: getAdminToken() });

    activityBody.innerHTML = result.activity.map((a) => `
      <tr>
        <td>${a.type}${a.first_name ? ` — ${a.first_name} ${a.last_name}` : ''}</td>
        <td>${a.state || '—'}</td>
        <td style="text-align:right;color:#8A9080;white-space:nowrap;">${dateTimeFmt(a.created_at)}</td>
      </tr>
    `).join('') || '<tr><td colspan="3">No matching activity.</td></tr>';

    const totalPages = Math.max(1, Math.ceil(result.total / PAGE_SIZE));
    paginationInfo.textContent = `Showing ${result.activity.length ? (currentPage - 1) * PAGE_SIZE + 1 : 0}–${(currentPage - 1) * PAGE_SIZE + result.activity.length} of ${result.total}`;
    prevPageBtn.disabled = currentPage <= 1;
    nextPageBtn.disabled = currentPage >= totalPages;

  } catch (err) {
    if (err.status === 401 || err.status === 403) { logoutAdmin(); return; }
    activityBody.innerHTML = '<tr><td colspan="3">Couldn\'t reach the server to load activity.</td></tr>';
    paginationInfo.textContent = '';
  }
}

[activitySearch, typeFilter].forEach((el) => el.addEventListener('input', () => { currentPage = 1; renderTable(); }));
prevPageBtn.addEventListener('click', () => { currentPage--; renderTable(); });
nextPageBtn.addEventListener('click', () => { currentPage++; renderTable(); });

renderTable();
